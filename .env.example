# Netlify environment variables — never commit the real values
ADMIN_PASSWORD=choose-a-long-unique-password
ADMIN_SESSION_SECRET=generate-a-long-random-secret
GITHUB_TOKEN=github_pat_with_contents_read_write
GITHUB_OWNER=your-github-user-or-org
GITHUB_REPO=dreamscape-hd
GITHUB_BRANCH=main
# Public site URL, used by the function when rebuilding sitemap.xml
SITE_URL=https://your-site.netlify.app
